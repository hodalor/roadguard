#!/bin/zsh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

export FLUTTER_ROOT="$SCRIPT_DIR/.flutter-sdk"
export XDG_CONFIG_HOME="$SCRIPT_DIR/.local-config"
export PUB_CACHE="$SCRIPT_DIR/.pub-cache"
export GRADLE_USER_HOME="$SCRIPT_DIR/.gradle"
export KOTLIN_USER_HOME="$SCRIPT_DIR/.kotlin"
export ANDROID_SDK_ROOT="/Users/macbook/Library/Android/sdk"
export ANDROID_HOME="$ANDROID_SDK_ROOT"
export PATH="$FLUTTER_ROOT/bin:$PATH"
export GRADLE_OPTS="-Dkotlin.user.home=$KOTLIN_USER_HOME ${GRADLE_OPTS:-}"

if command -v /usr/libexec/java_home >/dev/null 2>&1; then
  export JAVA_HOME="${JAVA_HOME:-$(/usr/libexec/java_home -v 17 2>/dev/null || /usr/libexec/java_home 2>/dev/null)}"
fi

mkdir -p "$XDG_CONFIG_HOME" "$PUB_CACHE" "$GRADLE_USER_HOME" "$KOTLIN_USER_HOME"

exec "$FLUTTER_ROOT/bin/flutter" "$@"
